rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace with the Google account you use to administer this blog.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'luxiaoyu8888@gmail.com';
    }

    function validComment() {
      return request.resource.data.keys().hasOnly(['articleId', 'name', 'content', 'timestamp', 'uid'])
        && request.resource.data.articleId is string
        && request.resource.data.articleId.size() > 0
        && request.resource.data.articleId.size() <= 128
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.timestamp is timestamp
        && request.resource.data.uid == request.auth.uid;
    }

    match /artifacts/blog-6dd2d/public/data/articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /artifacts/blog-6dd2d/public/data/settings/main {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /artifacts/blog-6dd2d/public/data/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && validComment();
      allow update, delete: if isAdmin() || (
        request.auth != null
        && resource.data.uid == request.auth.uid
      );
    }

    // Everything else, including old client-side "security" records, is denied.
  }
}
